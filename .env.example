MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority&appName=<appName>"
# Если Atlas недоступен (whitelist/VPN), в dev будет попытка подключиться сюда:
MONGODB_FALLBACK_URI="mongodb://127.0.0.1:27017/diplomawork"

# Для скрипта npm run seed:demo (опционально, иначе дефолты в lib/demo/seed-fixtures.ts)
JOBFLOW_DEMO_EMPLOYER_PASSWORD=
JOBFLOW_DEMO_EMPLOYEE_PASSWORD=

# Optional: HeadHunter job-ingestion (lib/job-ingestion/hh) — set HH_USER_AGENT for API etiquette
# HH_API_BASE_URL=https://api.hh.ru
# HH_USER_AGENT=YourApp/1.0 (your@email)
# HH_API_TOKEN=
# HH_FETCH_MAX_PAGES=2
# HH_FETCH_PER_PAGE=10
# HH_FETCH_MAX_VACANCIES=24
# HH_FETCH_SEARCH_QUERY=IT developer
# Optional: bcrypt input for synthetic ingestion employers (see lib/job-ingestion/persistence)
# INGESTION_EMPLOYER_PASSWORD=
